<?xml version="1.0" encoding="utf-8"?>
<!-- 根 NestedScrollView：focusableInTouchMode + saveEnabled=false 双保险，
     避免进入页面时恢复上次滚动位置而落在底部 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:saveEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 状态区：仅显示 BLE 广播/连接状态（经典 HID 操作已迁移到各模式页） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/status_unregistered"
                android:textColor="@color/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- BLE HOGP 翻页器入口（推荐模式） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_ble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/btn_open_ble" />

        <!-- 经典系统 HID（priv-app 特权）入口：需先安装 magisk-module 获得 BLUETOOTH_PRIVILEGED -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_syshid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/btn_open_syshid" />

        <!-- 经典模式不可用标注（未装 priv-app 模块时 stock 系统的诊断结论） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/classic_mode_unavailable"
            android:textColor="@color/colorError"
            android:textSize="13sp" />

        <!-- 翻页遥控（View 版）入口，不影响任何 HID 逻辑 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_pager_remote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="翻页遥控（View 版）" />

        <!-- 环境自检入口：诊断蓝牙/HID 注册环境，不影响任何 HID 逻辑 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_diagnosis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_open_diagnosis" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
