<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 状态显示 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/view_tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/miuix_status_idle"
            android:textColor="@color/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 媒体模式切换 -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/view_switch_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/switch_media_mode"
        android:textSize="15sp" />

    <!-- 上一页 / 下一页 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_btn_page_up"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/btn_page_up"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_btn_page_down"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_page_down"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
