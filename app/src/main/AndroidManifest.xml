<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+ (API 31+) 运行时蓝牙权限；声明扫描不推导出位置 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLE 外设广播（HOGP 翻页器模式） -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Android 11 及以下经典蓝牙权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 经典 HID Device 特权权限：signature|privileged 保护级，普通安装不授予；
         仅当 App 预置为 /system/priv-app（随 magisk-module 安装）且在
         system/etc/permissions allowlist 中声明后才生效，从而拿到非 null 的
         BluetoothHidDevice 代理 -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <!-- Android 11 及以下经典扫描需要定位 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- 前台服务与通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <!-- BLE 外设广播：大多数手机支持，不强制 -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.HidPager">

        <activity
            android:name="com.hidpager.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Miuix（Compose）示例页面：由 MainActivity 内按钮跳入，不对外导出 -->
        <activity
            android:name="com.hidpager.MiuixActivity"
            android:exported="false"
            android:label="Miuix 演示" />

        <!-- 环境自检/诊断页：由主界面按钮跳入，不对外导出 -->
        <activity
            android:name="com.hidpager.DiagnosisActivity"
            android:exported="false"
            android:label="@string/diagnosis_title" />

        <!-- BLE HOGP 翻页器模式页：由主界面按钮跳入，不对外导出 -->
        <activity
            android:name="com.hidpager.ble.BlePagerActivity"
            android:exported="false"
            android:label="@string/ble_title" />

        <!-- 经典系统 HID（priv-app 特权）状态页：由主界面按钮跳入，不对外导出 -->
        <activity
            android:name="com.hidpager.hid.SystemHidActivity"
            android:exported="false"
            android:label="@string/syshid_title" />

        <service
            android:name="com.hidpager.hid.HidDeviceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- BLE 广播保活前台服务 -->
        <service
            android:name="com.hidpager.ble.BlePagerService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
